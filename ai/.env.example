# ── TMDb (used during ingestion to match titles → TMDb IDs) ──
TMDB_API_KEY=your-tmdb-api-key

# ── LanceDB Cloud (Vector database) ───────────────
LANCE_DB_URI=db://your-database-uri
LANCE_API_KEY=your-lancedb-api-key
LANCE_TABLE_NAME=movie_quotes

# ── Embedding model (optional override) ───────────
# Defaults to sentence-transformers/all-MiniLM-L6-v2 (384-dim)
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
